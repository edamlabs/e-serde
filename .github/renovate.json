{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "enabledManagers": [
    "cargo",
    "github-actions",
    "pep621"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "Europe/Madrid",
  "prConcurrentLimit": 3,
  "abandonmentThreshold": "1 year",
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on the first day of the month"
    ],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "requires-python is a support promise, not a dependency: never bumped by a bot.",
      "matchDepTypes": [
        "requires-python"
      ],
      "enabled": false
    },
    {
      "description": "Rust crates are the library's runtime: one weekly PR, patches split from minors so they can merge themselves.",
      "matchManagers": [
        "cargo"
      ],
      "groupName": "rust crates",
      "separateMinorPatch": true,
      "labels": [
        "runtime"
      ]
    },
    {
      "description": "Rust patch releases merge themselves once every required check passes; minor and major wait for a human.",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "saphyr pinned: 0.1.0 regressed YAML spec null semantics; revisit upstream.",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^saphyr/"
      ],
      "enabled": false
    },
    {
      "description": "Python tooling (dependency groups and the build backend): one weekly PR, merges itself on green.",
      "matchManagers": [
        "pep621"
      ],
      "groupName": "python tooling",
      "labels": [
        "tooling"
      ],
      "matchDepTypes": [
        "dependency-groups",
        "build-system.requires"
      ],
      "automerge": true
    },
    {
      "description": "Workflow actions stay pinned by digest; one monthly PR.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "pinDigests": true,
      "schedule": [
        "before 6am on the first day of the month"
      ],
      "labels": [
        "tooling"
      ],
      "automerge": true
    },
    {
      "description": "Runtime deps of a library: widen the range, never raise the floor users resolve against.",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "project.dependencies"
      ],
      "rangeStrategy": "widen",
      "labels": [
        "runtime"
      ]
    },
    {
      "description": "Runtime patch releases merge themselves once every required check passes.",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "project.dependencies"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    }
  ],
  "platformAutomerge": true,
  "automergeType": "pr"
}
